# Airtable Configuration
AIRTABLE_API_KEY=your_airtable_api_key_here
AIRTABLE_BASE_ID=your_base_id_here

# n8n Configuration
N8N_API_URL=https://fagiolinosssssss.app.n8n.cloud
N8N_API_KEY=your_n8n_api_key_here

# OpenAI Configuration (for AI personalization)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4-turbo-preview

# Modal Configuration (for serverless campaign execution)
MODAL_TOKEN_ID=your_modal_token_id_here
MODAL_TOKEN_SECRET=your_modal_token_secret_here

# Twilio Configuration (SMS)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=your_twilio_phone_number_here

# Mailchimp Configuration (Email)
MAILCHIMP_API_KEY=your_mailchimp_api_key_here
MAILCHIMP_SERVER_PREFIX=us1
MAILCHIMP_LIST_ID=your_mailchimp_list_id_here

# Campaign Settings
CAMPAIGN_TIMEZONE=Europe/Zurich
MAX_EMAILS_PER_DAY=50
MAX_SMS_PER_DAY=30

# Safety & Testing
DRY_RUN_MODE=true
TEST_EMAIL=your_test_email@example.com
TEST_PHONE=+41_your_test_phone

# Logging
LOG_LEVEL=INFO
LOG_FILE=outreach_automation.log
