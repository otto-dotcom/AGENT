      },
      "id": "airtable-update-not-interested",
      "name": "Mark as Not Interested",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 1,
      "position": [1050, 400],
      "credentials": {
        "airtableApi": {
          "id": "1",
