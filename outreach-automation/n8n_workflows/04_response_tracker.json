{
  "name": "RESPONSE_TRACKER",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "response-webhook",
        "options": {}
      },
      "id": "webhook-response",
      "name": "Response Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 300],
      "webhookId": "response-tracker-webhook"
    },
    {
      "parameters": {
        "functionCode": "// Parse incoming response\nconst responseData = items[0].json;\n\n// Extract key information\nconst emailOrPhone = responseData.from || responseData.From;\nconst messageContent = responseData.text || responseData.Body || '';\nconst responseType = responseData.type || (emailOrPhone.includes('@') ? 'email' : 'sms');\n\n// Analyze sentiment from response\nconst content = messageContent.toLowerCase();\nlet sentiment = 'neutral';\nlet interested = false;\n\n// Positive indicators\nif (content.match(/yes|yeah|sure|interested|definitely|absolutely|sounds good|let's talk|call me/)) {\n  sentiment = 'positive';\n  interested = true;\n}\n\n// Negative indicators\nif (content.match(/no|not interested|stop|remove|unsubscribe|don't contact/)) {\n  sentiment = 'negative';\n  interested = false;\n}\n\n// Question or request for info\nif (content.match(/\\?|what|how|when|tell me more|details|info/)) {\n  sentiment = 'curious';\n  interested = true;\n}\n\nreturn [{\n  json: {\n    ...responseData,\n    contact: emailOrPhone,\n    message: messageContent,\n    responseType: responseType,\n    sentiment: sentiment,\n    interested: interested,\n    timestamp: new Date().toISOString()\n  }\n}];"
      },
      "id": "analyze-response",
      "name": "Analyze Response",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [450, 300]
    },
    {
      "parameters": {
        "operation": "list",
        "application": "${AIRTABLE_BASE_ID}",
        "table": "Leads",
        "options": {
          "filterByFormula": "OR({Email}='{{$json.contact}}', {Phone Number}='{{$json.contact}}')"
        }
      },
      "id": "airtable-find-lead",
      "name": "Find Lead Record",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 1,
      "position": [650, 300],
      "credentials": {
        "airtableApi": {
          "id": "1",
          "name": "Airtable API"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{$json.interested}}",
              "value2": true
            }
          ]
        }
      },
      "id": "if-interested",
      "name": "If Interested?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [850, 300]
    },
    {
      "parameters": {
        "operation": "update",
        "application": "${AIRTABLE_BASE_ID}",
        "table": "Leads",
        "id": "={{$json.id}}",
        "fields": {
