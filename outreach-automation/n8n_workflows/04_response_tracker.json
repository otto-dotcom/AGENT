    },
    {
      "parameters": {
        "operation": "sendEmail",
        "fromEmail": "${SENDER_EMAIL}",
        "toEmail": "=${TEAM_EMAIL}",
        "subject": "🎉 New Interested Lead: {{$json.fields['Company Name']}}",
        "text": "Great news! We have a positive response from:\n\nCompany: {{$json.fields['Company Name']}}\nContact: {{$json.fields['Contact Person']}}\nEmail: {{$json.fields['Email']}}\nPhone: {{$json.fields['Phone Number']}}\n\nTheir response:\n{{$json.message}}\n\nResponse Type: {{$json.responseType}}\nSentiment: {{$json.sentiment}}\n\nNext steps: Schedule a call!",
        "options": {}
      },
      "id": "notify-team-interested",
      "name": "Notify Team (Interested)",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 1,
      "position": [1250, 200]
    },
    {
      "parameters": {
        "functionCode": "// Generate automatic response based on sentiment\nconst sentiment = items[0].json.sentiment;\nconst firstName = items[0].json.fields['Contact Person'].split(' ')[0];\nconst responseType = items[0].json.responseType;\n\nlet responseMessage = '';\n\nif (sentiment === 'positive') {\n  responseMessage = `Awesome! Here's my calendar: [calendar_link]. Or I can call you - what's best?`;\n} else if (sentiment === 'curious') {\n  responseMessage = `Thanks for asking, ${firstName}! I'll send you a quick email with details. Should be in your inbox in 2 minutes.`;\n} else if (sentiment === 'negative') {\n  responseMessage = `No problem, ${firstName}! I've removed you from my list. You won't hear from me again. Best of luck!`;\n}\n\nreturn [{\n  json: {\n    ...items[0].json,\n    autoResponse: responseMessage\n  }\n}];"
      },
      "id": "generate-auto-response",
      "name": "Generate Auto Response",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [1250, 400]
    }
  ],
