            },
            {
              "fieldId": "Response Sentiment",
              "fieldValue": "={{$json.sentiment}}"
            }
          ]
        }
      },
      "id": "airtable-update-interested",
      "name": "Mark as Interested",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 1,
      "position": [1050, 200],
      "credentials": {
        "airtableApi": {
          "id": "1",
          "name": "Airtable API"
        }
      }
    },
    {
      "parameters": {
        "operation": "update",
        "application": "${AIRTABLE_BASE_ID}",
        "table": "Leads",
        "id": "={{$json.id}}",
        "fields": {
          "customFieldsValues": [
            {
              "fieldId": "Status",
              "fieldValue": "Responded - Not Interested"
